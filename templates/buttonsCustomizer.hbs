<div class="vn-buttons-customizer">
    <p class="vbc-hint">{{localize "visual-novel-reverse.buttonsCustomizer.hint"}}</p>
    <div class="vbc-header">
        <button type="button" class="vbc-add-button" data-action="addButton"><i class="fas fa-plus"></i> {{localize "visual-novel-reverse.buttonsCustomizer.newButton"}}</button>
    </div>
    <div class="vbc-list-body">
        {{#each buttons}}
        <div class="vbc-list-item" data-id="{{this.id}}">
            <i class="vbc-item-icon {{this.iconClass}}"></i>
            <input type="text" data-key="name" value="{{this.name}}">
            <span class="vbc-executeAs-text">{{localize "visual-novel-reverse.buttonsCustomizer.executeAs"}}</span>
            <select data-key="executor">
                <option value="player" {{#if (eq this.executor "player")}}selected{{/if}}>{{localize "visual-novel-reverse.buttonsCustomizer.executeAsPlayer"}}</option>    
                <option value="gm" {{#if (eq this.executor "gm")}}selected{{/if}}>{{localize "visual-novel-reverse.buttonsCustomizer.executeAsGM"}}</option>
            </select>
            <span class="vbc-buttonAction-text">{{localize "visual-novel-reverse.buttonsCustomizer.buttonAction"}}</span>
            <select data-key="action">
                <option value="macros" {{#if (eq this.action "macros")}}selected{{/if}}>{{localize "visual-novel-reverse.buttonsCustomizer.runsMacros"}}</option>    
                <option value="command" {{#if (eq this.action "command")}}selected{{/if}}>{{localize "visual-novel-reverse.buttonsCustomizer.executeCommand"}}</option>
                <option value="dataAction" {{#if (eq this.action "dataAction")}}selected{{/if}}>{{localize "visual-novel-reverse.buttonsCustomizer.dataAction"}}</option>
            </select>
            {{#if (eq this.action "macros")}}
                <div class="vbc-macros-box">
                    {{#if this.macrosName}}
                        <div class="vbc-macros-item"></div> {{!-- плейсхолдер --}}
                    {{/if}}
                </div>
            {{else if (eq this.action "command")}}
                <input type="text" data-key="command" value="{{this.command}}">
            {{else if (eq this.action "dataAction")}}
                <select data-key="dataAction">
                    {{#each ../dataActions}}
                        <option value="{{this}}" {{#if (eq ../dataAction this)}}selected{{/if}}>{{localize (concat "visual-novel-reverse.dataActions." this)}}</option>
                    {{/each}}
                </select>
            {{/if}}
            <button type="button" class="vbc-delete-button" data-action="deleteButton"><i class="fas fa-trash"></i></button>
            <button type="button" class="vbc-duplicate-button" data-action="duplicateButton"><i class="fas fa-clone"></i></button>
        </div>
        {{/each}}
    </div>
</div>